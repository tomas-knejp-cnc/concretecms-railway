# Použij hotový ConcreteCMS image z docker5 repozitáře
FROM concretecms/php8.2-apache:latest

# Nastav pracovní adresář
WORKDIR /app

# Zkopíruj všechny lokální soubory (např. configy, theme apod.)
COPY . /app

# Nastavení práv
RUN chown -R www-data:www-data /app

# Apache poslouchá na 8080 (Railway to vyžaduje)
ENV PORT=8080
RUN sed -i 's/80/${PORT}/g' /etc/apache2/ports.conf && \
    sed -i 's/:80/:${PORT}/g' /etc/apache2/sites-enabled/000-default.conf

# Nastavení proměnných z Railway (DB plugin)
ENV CONCRETE_DB_HOST=$MYSQLHOST
ENV CONCRETE_DB_USERNAME=$MYSQLUSER
ENV CONCRETE_DB_PASSWORD=$MYSQLPASSWORD
ENV CONCRETE_DB_DATABASE=$MYSQLDATABASE

# Zapni mod_rewrite (ConcreteCMS to potřebuje pro pretty URLs)
RUN a2enmod rewrite

# Exponuj port
EXPOSE 8080

# Start Apache serveru
CMD ["apache2-foreground"]
